   VALUE "OriginalFilename", "Bootriva.exe"
   VALUE "ProductName", "BOOTRIVA"
   VALUE "ProductVersion", "0.2.2"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
