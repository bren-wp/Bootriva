#include <windows.h>
101 ICON "@CMAKE_SOURCE_DIR@/packaging/bootriva.ico"
201 RCDATA "@CMAKE_SOURCE_DIR@/tools/create-windows-usb.ps1"
1 RT_MANIFEST "@CMAKE_SOURCE_DIR@/packaging/app.manifest"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,2,0
 PRODUCTVERSION 0,2,2,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 0x40004L
 FILETYPE 1
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "BRENDIGO"
   VALUE "FileDescription", "BOOTRIVA - USB Creator"
   VALUE "FileVersion", "0.2.2"
   VALUE "InternalName", "Bootriva"
