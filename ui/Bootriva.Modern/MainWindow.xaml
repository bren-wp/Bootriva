<Window
    x:Class="Bootriva.Modern.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BOOTRIVA | Create · Flash · Boot">

    <Grid Background="#F5F7FA" RequestedTheme="Light"
          RowDefinitions="Auto,*,Auto">
        <Grid.Resources>
            <Style x:Key="SectionCard" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="BorderBrush" Value="#E3E8EF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#172338"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>
            <Style x:Key="InputLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#59697E"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
            </Style>
        </Grid.Resources>

        <Grid Grid.Row="0" Padding="26,18,26,15"
              Background="White"
              ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
                <TextBlock Text="BOOTRIVA" FontSize="27" FontWeight="Bold"
                           Foreground="#0079CD"/>
                <TextBlock Text="Create. Flash. Boot.  •  BRENDIGO"
                           FontSize="12" Foreground="#758398"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Border Background="#EDF6FF" CornerRadius="9" Padding="10,6">
                    <TextBlock Text="WINUI 3  ·  PREVIEW" FontSize="11"
                               Foreground="#1764A7" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,19,24,24" Spacing="0">
                <TextBlock Text="USB Creator" FontWeight="SemiBold" FontSize="22"
                           Foreground="#192A43" Margin="2,0,0,4"/>
                <TextBlock Text="Pripremi sliku diska, provjeri integritet i odaberi siguran uređaj."
                           Foreground="#69798E" FontSize="13" TextWrapping="Wrap"
                           Margin="2,0,0,19"/>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="01  ·  Windows ISO katalog"
                                   Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Službena Microsoftova izdanja" Style="{StaticResource InputLabel}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <ComboBox x:Name="DistributionCombo" MinWidth="180"
                                      HorizontalAlignment="Stretch"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Windows 11 (x64)"/>
                                <ComboBoxItem Content="Windows 10 (legacy)"/>
                                <ComboBoxItem Content="Windows Server 2025 Evaluation"/>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Microsoft" Click="OpenOfficialIso"
                                    Padding="15,9" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="ISO datoteke preuzimaju se izravno od Microsofta, nisu uključene u aplikaciju."
                                   FontSize="12" Foreground="#748297" Margin="0,11,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="02  ·  Izvorna slika diska"
                                   Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="ISO, IMG ili BIN" Style="{StaticResource InputLabel}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBox x:Name="ImagePath" PlaceholderText="Odaberi datoteku..."
                                     IsReadOnly="True" MinWidth="150"
                                     HorizontalAlignment="Stretch"/>
                            <Button Grid.Column="1" Content="Odaberi" Click="BrowseImage"
                                    Padding="15,9"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,12,0,0">
                            <Button x:Name="AnalyzeButton" Click="AnalyzeImage"
                                    IsEnabled="False" Content="Provjeri sliku"/>
                            <Button Grid.Column="1" x:Name="HashButton" Click="CalculateHash"
                                    IsEnabled="False" Content="SHA-256"/>
                        </Grid>
                        <TextBlock x:Name="ImageSummary" FontSize="12" Foreground="#607187"
                                   TextWrapping="Wrap" Margin="0,11,0,0"
                                   Text="Nijedna datoteka nije odabrana."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="03  ·  USB uređaji" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Pregled prijenosnih uređaja (bez brisanja podataka)"
                                   Style="{StaticResource InputLabel}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <ComboBox x:Name="DriveCombo" HorizontalAlignment="Stretch"
                                      PlaceholderText="Nema učitanih USB uređaja"/>
                            <Button Grid.Column="1" Content="Osvježi" Click="RefreshDrives"
                                    Padding="15,9"/>
                        </Grid>
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                                 Title="Sigurnosna granica"
                                 Message="Ovo je nova WinUI 3 razvojna aplikacija. Zapisivanje na USB još nije uključeno dok se ne verificira veza s postojećim C++ pogonom."
                                 Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="04  ·  Aktivnost i sigurnost"
                                   Style="{StaticResource SectionTitle}"/>
                        <ProgressBar x:Name="OperationProgress" Height="4" Minimum="0"
                                     Maximum="100" Value="0"/>
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                                   Text="Spremno za analizu ISO datoteke."
                                   Foreground="#4D607A" FontSize="13"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="BOOTRIVA 0.2.5  ·  BRENDIGO  ·  brendigo.com"
                           HorizontalAlignment="Center" FontSize="11" Foreground="#8996A9"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Background="White" Padding="22,12"
              ColumnDefinitions="*,Auto">
            <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="Nativni Windows 11 dizajn" FontWeight="SemiBold"
                           Foreground="#19324D" FontSize="12"/>
                <TextBlock Text="WinUI 3 / Windows App SDK" FontSize="11"
                           Foreground="#8794A4"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#E9F7F0"
                    CornerRadius="9" Padding="10,7"
                    VerticalAlignment="Center">
                <TextBlock Text="READ-ONLY PREVIEW" FontSize="11"
                           FontWeight="SemiBold" Foreground="#1D7851"/>
            </Border>
        </Grid>
    </Grid>
</Window>
